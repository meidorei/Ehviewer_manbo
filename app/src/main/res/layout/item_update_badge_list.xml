<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/update_badge_count"
        android:layout_width="@dimen/update_badge_count_width"
        android:layout_height="match_parent"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textSize="@dimen/text_little_small"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/update_badge_indicator"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:singleLine="true"
        android:textSize="@dimen/text_little_small"
        android:textColor="?android:attr/textColorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/update_badge_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="@dimen/text_little_small"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/update_badge_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:importantForAccessibility="no"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="@dimen/update_badge_detail_text_size"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</LinearLayout>
